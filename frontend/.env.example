# =============================================================================
# TEMCO Customer Portal - Environment Variables
# =============================================================================
# Copy this file to .env and update values as needed.
# These are only used when NOT relying on Vite proxy (e.g., Docker builds).
# For local dev with `npm run dev`, the Vite proxy handles API routing.
# =============================================================================

# API URL - leave empty for local dev (Vite proxy handles routing)
VITE_API_URL=
